# Copy to .env and fill in. Never commit .env.
# Everything here configures the LOCAL MOCK only. There are no real keys in this repo.

# Organization key for the mock: sk_sandbox_ + 32 hex characters.
# Leave empty and the mock creates one in .mock/org_key on first run.
MOCK_ORG_KEY=

MOCK_HOST=127.0.0.1
MOCK_PORT=8787
MOCK_DB_PATH=mock.db
MOCK_RATE_LIMIT=600
MOCK_WEBHOOK_INTERVAL=1
MOCK_LOG_LEVEL=INFO

# Fault injection for POST /v1/authorizations (also settable at runtime via POST /_mock/faults)
MOCK_LATENCY_MS=0
MOCK_ERROR_RATE=0
MOCK_TIMEOUT_RATE=0
MOCK_TIMEOUT_SECONDS=30
MOCK_429_BURST=0
MOCK_RETRY_AFTER=1
# Replace every verdict with this code (e.g. deny_future_rule) to test unknown-verdict handling
MOCK_FORCED_VERDICT=
MOCK_FAULT_SEED=

# spend_guard (the client, gate and reconcile command). Again: local mock only.
SPEND_GUARD_BASE_URL=http://127.0.0.1:8787
# Org key for `make reconcile` (reads the export). Leave empty to use .mock/org_key.
# Never give an org key to an agent: the gate itself uses the agent's own ak_ key.
SPEND_GUARD_ORG_KEY=
# The mock payment provider's stand-in credential. Leave empty to generate one per run.
MOCK_PROVIDER_SECRET=

# MCP server (python -m mcp_server). `scripts/seed_mock.py` writes these to .mock/agent.env;
# point the server at that file with SPEND_GUARD_ENV_FILE instead of setting them by hand.
SPEND_GUARD_ENV_FILE=
# An agent key (ak_...) only. The server refuses to start with an organization key.
SPEND_GUARD_AGENT_KEY=
# Comma-separated mandate ids the verifier accepts, and recipients the gate may pay.
SPEND_GUARD_MANDATES=
SPEND_GUARD_ALLOWED_RECIPIENTS=
SPEND_GUARD_LEDGER_DB=ledger.db
SPEND_GUARD_PROVIDER_DB=provider.db
SPEND_GUARD_NONCE_DB=nonces.db

# OpenAI Agents SDK example (integrations/openai_agents/example_agent.py). Optional:
# without OPENAI_API_KEY the example calls no model and prints how to run it.
OPENAI_API_KEY=
SPEND_GUARD_MODEL=gpt-4.1-mini

# `make demo`: seconds to pause between steps. 0 removes the pauses.
DEMO_PAUSE=1.2
